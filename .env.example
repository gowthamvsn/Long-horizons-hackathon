# ---- Main LLM (tutor) ----
# "anthropic" (default) or "bedrock"
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5
# low | medium | high  (lower = faster/cheaper sim runs)
LLM_EFFORT=low
ANTHROPIC_API_KEY=
# Bedrock (only if LLM_PROVIDER=bedrock). Uses standard AWS credential chain.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Bedrock model id (anthropic.-prefixed)
BEDROCK_MODEL=anthropic.claude-opus-5

# ---- RawTree (archive + all dashboard data) ----
RAWTREE_API_KEY=
RAWTREE_DATABASE=chapters

# ---- Nimble (real-time web facts) ----
NIMBLE_API_KEY=

# ---- Black Forest Labs FLUX (covers) ----
BFL_API_KEY=
BFL_MODEL=flux-2-pro

# ---- Liquid AI LFM2 curator (local via Ollama) ----
# "ollama" (default) or "llm" to fall back to the main LLM
CURATOR_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
CURATOR_MODEL=hf.co/LiquidAI/LFM2-1.2B-GGUF:Q4_K_M
